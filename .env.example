APP_NAME="RMSignage"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
SERVER_PORT=8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=dz_signage
DB_USERNAME=dz_signage
DB_PASSWORD=secret

# Pest uses dz_signage_testing via phpunit.xml (same host/credentials)

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Screen presence (config/screens.php). A Screen is Online when its device
# reported in within SCREEN_ONLINE_THRESHOLD seconds.
SCREEN_HEARTBEAT_INTERVAL=45
SCREEN_ONLINE_THRESHOLD=90
SCREEN_HEARTBEAT_RETENTION_DAYS=7
DZ_PLAYER_VERSION=1.0.0

# Billing (config/billing_plans.php + config/billing.php + Cashier).
# Authoritative catalog: Starter / Business / Enterprise (no Pro).
# Workspace is the Stripe customer; Screen licences = subscription quantity.
# Leave BILLING_ENFORCE=false until Stripe prices are configured.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=gbp
# Legacy aliases (map to Starter when plan-specific IDs are unset)
DZ_SIGNAGE_MONTHLY_PRICE_ID=
DZ_SIGNAGE_YEARLY_PRICE_ID=
# Plan-specific Stripe Price IDs (create new Prices when amounts change)
DZ_SIGNAGE_STARTER_MONTHLY_PRICE_ID=
DZ_SIGNAGE_STARTER_YEARLY_PRICE_ID=
DZ_SIGNAGE_BUSINESS_MONTHLY_PRICE_ID=
DZ_SIGNAGE_BUSINESS_YEARLY_PRICE_ID=
BILLING_ENFORCE=false
BILLING_MIN_SCREEN_LICENSES=1
BILLING_MAX_SCREEN_LICENSES=500
# Optional catalog amount overrides (pence). Defaults: Starter 1900/18000, Business 4900/46800.
# BILLING_STARTER_MONTHLY_AMOUNT=1900
# BILLING_STARTER_YEARLY_AMOUNT=18000
# BILLING_STARTER_YEARLY_EQ=1500
# BILLING_BUSINESS_MONTHLY_AMOUNT=4900
# BILLING_BUSINESS_YEARLY_AMOUNT=46800
# BILLING_BUSINESS_YEARLY_EQ=3900

# AI content generation (config/ai.php). Keys stay server-side.
# provider: fake | openai_compatible
AI_ENABLED=false
AI_PROVIDER=fake
AI_QUALITY_MODE=premium
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=gpt-4o
AI_IMAGE_MODEL=gpt-image-1
AI_DESIGN_MODEL=gpt-4o
AI_HTTP_TIMEOUT=60
AI_RATE_PER_USER=10
AI_RATE_PER_WORKSPACE=60
AI_IMAGE_VARIANTS=2

# Analytics retention (config/analytics.php)
ANALYTICS_PLAYBACK_RETENTION_DAYS=90
ANALYTICS_DAILY_STATS_RETENTION_DAYS=400

# Widget external-data caches (config/widgets.php)
WIDGET_HTTP_TIMEOUT=8
WIDGET_WEATHER_CACHE_TTL=900
WIDGET_WEATHER_GEOCODE_TTL=86400
WIDGET_RSS_CACHE_TTL=600
WIDGET_RSS_MAX_BYTES=524288
WIDGET_CALENDAR_CACHE_TTL=600
WIDGET_CALENDAR_MAX_BYTES=524288

VITE_APP_NAME="${APP_NAME}"
VITE_DZ_PLAYER_VERSION="${DZ_PLAYER_VERSION}"

# Production demo account (php artisan rmsignage:seed-demo-account --allow-production)
# Never commit the password. Required only when seeding the isolated demo Business.
RMSIGNAGE_DEMO_EMAIL=demo@rmsignage.com
# RMSIGNAGE_DEMO_PASSWORD=
